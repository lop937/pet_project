{{define "header"}}
    <!doctype html>
    <html lang="en">
    <head>

        <meta charset="UTF-8"/>
        <meta name="viewport"
              content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
        <script src="https://unpkg.com/htmx.org@1.9.12"
                integrity="sha384-ujb1lZYygJmzgSwoxRggbCHcjc0rB2XoQrxeTUQyRjrOnlCoYta87iKBWq3EsdM2"
                crossorigin="anonymous"></script>
        <script src="/static/tailwind.js"></script>
        <script src="/static/htmx.min.js"></script>
        <title>GRIFF</title>
    </head>
    <body>
        <div class="min-h-svh p-2 bg-slate-50" style="padding-top: max(0.5rem, env(safe-area-inset-top));">
        <nav class="mb-3 grid grid-cols-{{.navs | len}} w-full h-12 bg-slate-50 border-b border-slate-200">
            {{$route := .route}}
            {{ range $nav := .navs }}
                <a href="/{{$nav}}"
                   class="flex items-center justify-center relative transition-all duration-200 active:bg-slate-200/50
           {{ if eq $nav $route }}
               text-slate-900
           {{ else }}
               text-slate-400
           {{ end }}">
                    <!-- Текст пункта -->
                    <span class="text-[11px] font-bold uppercase tracking-tight">
                {{ $nav.NavName }}
            </span>
                    <!-- Акцентный индикатор как в блоке выручки -->
                    {{ if eq $nav $route }}
                        <!-- Тонкая полоска снизу -->
                        <div class="absolute bottom-0 left-2 right-2 h-0.5 bg-emerald-500 rounded-full"></div>
                        <!-- Еле заметный блик сверху для объема -->
                        <div class="absolute inset-0 bg-white/40 pointer-events-none"></div>
                    {{ end }}
                </a>
            {{ end }}
        </nav>
{{end}}