{{define "product_form"}}
    {{template "header" . }}

    <br>

    <form id="{{.route}}_table_form" method="post" action="/{{.route}}/{{.id}}" autocomplete="on">
        {{ range $field := .fields}}
            <div class="relative my-4">
                {{ if eq $field.Type "group" }}
                    {{template "group" $field.Group }}
                {{ else if eq $field.Type "select" }}
                    {{template "select" $field }}
                {{ else }}
                    <div id="field_wrapper_{{.Name}}">
                        {{template "input" $field }}
                    </div>
                {{end}}
            </div>
        {{end}}
    </form>

    <footer class="flex justify-start gap-2">
        <div class="px-3 py-6 space-y-3 w-full">
            <!-- Сохранить -->
            <button form="{{.route}}_table_form" type="submit"
                    class="flex items-center justify-center w-full h-12 bg-emerald-500 text-white rounded-2xl font-bold text-sm shadow-sm shadow-emerald-200 transition-all active:scale-[0.98] active:bg-emerald-600">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
                </svg>
                Сохранить и выйти
            </button>

{{if .showSystems}}
    <a href="/export/project/{{.id}}" class="{{template "btn_style"}}">
        <span class="{{template "btn_text_style"}}">Выгрузить в Excel</span>
    </a>
{{end}}

            <!-- Назад -->
            <a href="javascript:history.back()" class='{{template "btn_style"}}'>
                <div class="flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path>
                    </svg>
                    <span class='{{template "btn_text_style"}}'>Назад</span>
                </div>
            </a>

            <!-- Удалить -->
            {{ if .id}}
                <form action="/{{.route}}/{{.id}}" id="deleteForm" method="POST">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class='{{template "btn_style"}} !border-red-100 active:bg-red-50'>
                        <div class="flex items-center justify-center space-x-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash text-red-500" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                            </svg>
                            <span class='{{template "btn_text_style"}} !text-red-600'>Удалить</span>
                        </div>
                    </button>
                </form>
                <script>
                    const deleteForm = document.getElementById('deleteForm');
                    deleteForm.addEventListener('submit', function (event) {
                        const confirmation = confirm('Вы уверены, что хотите удалить этот элемент? Это действие необратимо.');
                        if (!confirmation) {
                            event.preventDefault();
                        }
                    });
                </script>
            {{end}}
        </div>
    </footer>

    {{template "footer"}}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const unitSelect = document.getElementById('unit_select');
            if (!unitSelect) return;

            function updateLabels() {
                const unit = unitSelect.value;
                let priceLabel = "Рубли за метр квадратный";
                let squareLabel = "Метров квадратных в единице";

                if (unit === "штуки") {
                    priceLabel = "Рубли за штуку";
                    squareLabel = ""; // возможно, поле не нужно
                } else if (unit === "метры погонные") {
                    priceLabel = "Рубли за метр погонный";
                    squareLabel = "Метров погонных в единице";
                }

                const priceLabelEl = document.querySelector('label[for="price_input"]');
                const squareLabelEl = document.querySelector('label[for="square_input"]');

                if (priceLabelEl) priceLabelEl.textContent = priceLabel;
                if (squareLabelEl) squareLabelEl.textContent = squareLabel;
            }

            unitSelect.addEventListener('change', updateLabels);
            updateLabels(); // начальная установка
        });
    </script>
{{end}}