{{define "form"}}
    {{template "header" . }}

    <br>
    {{if .product}}
        <a href="/products/{{.product.ID}}">
            {{template "product" .product }}
        </a>
    {{end}}

    <form id="{{.route}}_table_form" method="post" action="/{{.route}}/{{.id}}" autocomplete="on">
        {{ range $field := .fields}}
            <div class="relative my-4">
                {{ if eq $field.Type "group" }}
                    {{template "group" $field.Group }}
                {{ else if eq $field.Type "select" }}
                    {{template "select" $field }}
                {{ else }}
                    {{template "input" $field }}
                {{end}}
            </div>
        {{end}}
    </form>

    {{if eq .route "works"}}
    <div class="mt-4 p-4 bg-slate-50 rounded-2xl text-sm text-slate-600">
        <div class="flex justify-between mb-1">
            <span>Итого объем (м2):</span>
            <span id="calc_total_square" class="font-bold">0</span>
        </div>
        <div class="flex justify-between text-base font-bold text-slate-800">
            <span>Итого сумма:</span>
            <span id="calc_total_sum">0</span> ₽
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const qtyInput = document.getElementById('quantity_input');
            const priceInput = document.getElementById('price_input');
            
            // Безопасное получение площади (если товара нет, то 0)
            const squareInput = {{if .product}}{{.product.Square}}{{else}}0{{end}};

            function updateCalc() {
                if (!qtyInput || !priceInput) return;

                const qty = parseFloat(qtyInput.value.replace(',', '.')) || 0;
                const price = parseFloat(priceInput.value.replace(',', '.')) || 0;
                
                let totalSquare = squareInput > 0 ? (squareInput * qty) : qty;
                let totalSum = qty * price;

                const elSq = document.getElementById('calc_total_square');
                const elSum = document.getElementById('calc_total_sum');
                if (elSq) elSq.innerText = totalSquare.toFixed(2);
                if (elSum) elSum.innerText = totalSum.toFixed(2);
            }

            if (qtyInput && priceInput) {
                qtyInput.addEventListener('input', updateCalc);
                priceInput.addEventListener('input', updateCalc);
                updateCalc();
            }
        });
    </script>
    {{end}}

    <footer class="flex justify-start gap-2">
        <div class="px-3 py-6 space-y-3 w-full">
            <!-- Кнопка "Сохранить и выйти" -->
            <button form="{{.route}}_table_form" type="submit"
                    class="flex items-center justify-center w-full h-12 bg-emerald-500 text-white rounded-2xl font-bold text-sm shadow-sm shadow-emerald-200 transition-all active:scale-[0.98] active:bg-emerald-600">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
                </svg>
                Сохранить и выйти
            </button>

            {{if and .id (eq .route "works")}}
                <a href="/export/works/{{.id}}" class="{{template "btn_style"}} mt-2">
                    <div class="flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 mr-2 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"></path>
                        </svg>
                        <span class="{{template "btn_text_style"}}">Выгрузить работу</span>
                    </div>
                </a>

                <a href="/export/smeta/{{.project_id}}" class="{{template "btn_style"}} !border-blue-100 active:bg-blue-50 mt-2">
                    <div class="flex items-center justify-center">
                        <svg class="w-3.5 h-3.5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        <span class="{{template "btn_text_style"}} !text-blue-600">Выгрузить смету</span>
                    </div>
                </a>
            {{end}}

            <!-- Кнопка "Назад" -->
            <a href="javascript:history.back()" class='{{template "btn_style"}} mt-2'>
                <div class="flex items-center justify-center">
                    <svg class="w-3.5 h-3.5 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"></path>
                    </svg>
                    <span class='{{template "btn_text_style"}}'>Назад</span>
                </div>
            </a>

                        {{if .id}}
                <form action="/{{.route}}/{{.id}}" id="deleteForm" method="POST" class="mt-2">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class='{{template "btn_style"}} !border-red-100 active:bg-red-50 w-full' onclick="return confirm('Вы уверены, что хотите удалить этот элемент?');">
                        <div class="flex items-center justify-center space-x-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash text-red-500" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                            </svg>
                            <span class='{{template "btn_text_style"}} !text-red-600'>Удалить</span>
                        </div>
                    </button>
                </form>
            {{end}}
        </div>
    </footer>

    {{template "footer"}}

    <script>
    const selectColor = document.getElementById('select_color');
    const labelColor = document.getElementById('label_color');
    const buttonColor = document.getElementById('btnColor');

    if (selectColor && labelColor && buttonColor) {
        function applyColorClass(value) {
            const prefixes = {{.colors}}
            prefixes.forEach(prefix => {
                labelColor.classList.remove(`bg-${prefix}-200`);
                buttonColor.classList.remove(`bg-${prefix}-200`);
            });
            if (value) {
                labelColor.classList.add(`bg-${value}-200`);
                buttonColor.classList.add(`bg-${value}-200`);
            }
        }

        applyColorClass(selectColor.value);
        selectColor.addEventListener('change', (event) => {
            applyColorClass(event.target.value);
        });
    }
    </script>
{{end}}

        {{if eq .route "works"}}
    <script>
        function initCalculator() {
            const qtyInput = document.getElementById('quantity_input');
            const priceInput = document.getElementById('price_input');
            if (!qtyInput || !priceInput) return;

            const squareInput = {{if .product}}{{.product.Square}}{{else}}0{{end}};
            const elSq = document.getElementById('calc_total_square');
            const elSum = document.getElementById('calc_total_sum');

            function updateCalc() {
                const qty = parseFloat(String(qtyInput.value).replace(',', '.')) || 0;
                const price = parseFloat(String(priceInput.value).replace(',', '.')) || 0;
                
                // Считаем итоговый объем (м2)
                let totalSquare = squareInput > 0 ? (squareInput * qty) : qty;
                
                // СУММА = Объем (м2) * Цена за м2
                let totalSum = totalSquare * price;

                if (elSq) elSq.innerText = totalSquare.toFixed(2);
                if (elSum) elSum.innerText = totalSum.toFixed(2);
            }

            qtyInput.addEventListener('input', updateCalc);
            priceInput.addEventListener('input', updateCalc);
            updateCalc();
        }
        document.addEventListener("DOMContentLoaded", initCalculator);
        initCalculator();
    </script>
    {{end}}
